---
import { type Lang, t, other, paths, contact, ui, groupShort } from '../lib/i18n';
import { groups, hasPage, externalLinks } from '../lib/data';

interface Props {
  lang: Lang;
  /** Project slug or 'home': marks the active item. */
  current: string;
  /** Same page in the other language. */
  alternate: string;
}
const { lang, current, alternate } = Astro.props;
const home = paths.home(lang);
const onHome = current === 'home';
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const activeGroup = groups.find((g) => g.projects.some((p) => p.slug === current))?.id;
const itemHref = (g: (typeof groups)[number], p: (typeof groups)[number]['projects'][number]) =>
  hasPage(g) ? paths.project(p.slug, lang) : externalLinks(p)[0]?.href ?? '#';
const rail = [
  { id: 'about', label: ui.about[lang], short: ui.about[lang], icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>' },
  { id: 'projects', label: ui.projects[lang], short: ui.projects[lang], icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>' },
  { id: 'career', label: lang === 'en' ? 'Experience and education' : 'Experiencia y formación', short: lang === 'en' ? 'Career' : 'Trayectoria', icon: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5h8v2"/>' },
];
---
<header class="tb">
  <a href={home}>Óscar Romero Quincoces</a>
  <button type="button" id="nav-open" aria-controls="sidebar" aria-expanded="false">{ui.menu[lang]}</button>
</header>
<div class="scrim" id="scrim"></div>

<aside class="sb" id="sidebar" aria-label={lang === 'en' ? 'Site navigation' : 'Navegación del sitio'}>
  <nav class="rail-i" aria-label={lang === 'en' ? 'Sections' : 'Secciones'}>
    <a class="mk" href={home} aria-label="Óscar Romero Quincoces">ÓR</a>
    {rail.map((r) => (
      <a href={anchor(r.id)} data-sec={r.id} title={r.label} aria-current={!onHome && r.id === 'projects' && activeGroup ? 'true' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={r.icon} /><span class="rl">{r.short}</span>
      </a>
    ))}
    <button type="button" class="ct-btn" popovertarget="contact-pop" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><span class="rl">{ui.contactNav[lang]}</span></button>
    <span class="sp"></span>
    <a href={contact.github} title="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.9-2.4c3-.3 6-1.5 6-6.6a5 5 0 0 0-1.4-3.6 4.7 4.7 0 0 0-.1-3.5s-1.1-.3-3.6 1.4a12.5 12.5 0 0 0-6.6 0C5.9 1.1 4.8 1.4 4.8 1.4a4.7 4.7 0 0 0-.1 3.5A5 5 0 0 0 3.3 8.5c0 5.1 3 6.3 6 6.6a3 3 0 0 0-.9 2.4V21"/></svg><span class="rl">GitHub</span></a>
    <a href={contact.linkedin} title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/></svg><span class="rl">LinkedIn</span></a>
    <a class="lg" href={alternate} hreflang={other(lang)} lang={other(lang)} title={ui.switchLabel[lang]}><b>{other(lang).toUpperCase()}</b><span class="rl">{ui.switchTo[lang]}</span></a>
  </nav>

  <div class="panel">
    <div class="pn-h">
      <a href={home}>Óscar Romero Quincoces</a>
      <span>{ui.role_line[lang]}</span>
    </div>
    <nav class="pn-s" aria-label={ui.projects[lang]}>
      {groups.map((g) => (
        <details class={`g-${g.id}`} open={activeGroup ? g.id === activeGroup || g.id === 'products' : g.id !== 'course'}>
          <summary><span class="sw"></span><a class="t" href={anchor(`g-${g.id}`)}>{t(groupShort[g.id] ?? g.title, lang)}</a><span class="c">{g.projects.length}</span><span class="tg" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 6.5l3 3 3-3"/></svg></span></summary>
          <ul>
            {g.projects.map((p) => (
              <li><a href={itemHref(g, p)} aria-current={p.slug === current ? 'page' : undefined}><span class="dt"></span><span set:html={t(p.name, lang)} /></a></li>
            ))}
          </ul>
        </details>
      ))}
    </nav>
    <div class="pn-f"><button type="button" class="pn-mail" popovertarget="contact-pop">{contact.email}</button></div>
  </div>
</aside>

<div id="contact-pop" popover class="ct-pop" role="dialog" aria-label={ui.contactNav[lang]}>
  <div class="ct-top">
    <p class="ct-h">{ui.contactNav[lang]}</p>
    <button type="button" class="ct-x" popovertarget="contact-pop" popovertargetaction="hide" aria-label={lang === 'en' ? 'Close' : 'Cerrar'}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg></button>
  </div>
  <div class="ct-mail">
    <span>{contact.email}</span>
    <button type="button" class="ct-copy" data-copy={contact.email} data-done={lang === 'en' ? 'Copied' : 'Copiado'}>{lang === 'en' ? 'Copy' : 'Copiar'}</button>
  </div>
  <div class="ct-links">
    <a href={contact.linkedin}>LinkedIn</a>
    <a href={contact.github}>GitHub</a>
    <a href={`mailto:${contact.email}`}>{lang === 'en' ? 'Write an email' : 'Escribir un correo'}</a>
  </div>
</div>

<div class="lang-tip" id="lang-tip" hidden lang={other(lang)} data-off={current === '404' ? '1' : undefined}>
  <span>{lang === 'en' ? '¿Prefieres leer la web en español?' : 'Prefer to read the site in English?'}</span>
  <a href={alternate} hreflang={other(lang)}>{lang === 'en' ? 'Ver en español' : 'Read in English'}</a>
  <button type="button" aria-label={lang === 'en' ? 'Cerrar' : 'Close'}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg></button>
</div>

<main class="main" id="main">
  <slot />
</main>

<script>
  const body = document.body;
  const open = document.getElementById('nav-open')!;
  const sb = document.getElementById('sidebar')!;
  const setOpen = (v: boolean) => {
    body.classList.toggle('nav-open', v);
    open.setAttribute('aria-expanded', String(v));
    if (v) sb.querySelector<HTMLElement>('a')?.focus();
  };
  open.addEventListener('click', () => setOpen(!body.classList.contains('nav-open')));
  document.getElementById('scrim')!.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && body.classList.contains('nav-open')) { setOpen(false); open.focus(); } });
  sb.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  sb.querySelector('.pn-s a[aria-current]')?.scrollIntoView({ block: 'nearest' });
  // Contact card: copy the address without opening a mail program.
  document.querySelectorAll<HTMLButtonElement>('.ct-copy').forEach((b) => b.addEventListener('click', async () => {
    const label = b.textContent;
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = b.dataset.done!; }
    catch { getSelection()?.selectAllChildren(b.previousElementSibling!); }
    setTimeout(() => { b.textContent = label; }, 1600);
  }));
  // A group title is a link to its section: follow it and keep the group open.
  sb.querySelectorAll<HTMLAnchorElement>('summary a').forEach((a) => a.addEventListener('click', () => {
    const det = a.closest('details')!;
    setTimeout(() => { det.open = true; });
  }));

  // Offer the other language when the browser's language does not match the page.
  const tip = document.getElementById('lang-tip')!;
  const pageLang = document.documentElement.lang;
  const wants = (navigator.languages?.[0] || navigator.language || '').slice(0, 2).toLowerCase();
  let dismissed = false;
  try { dismissed = localStorage.getItem('lang-tip') === '1'; } catch {}
  if (!dismissed && !tip.dataset.off && (wants === 'es' || wants === 'en') && wants !== pageLang) tip.hidden = false;
  tip.querySelector('button')!.addEventListener('click', () => { tip.hidden = true; try { localStorage.setItem('lang-tip', '1'); } catch {} });
  tip.querySelector('a')!.addEventListener('click', () => { try { localStorage.setItem('lang-tip', '1'); } catch {} });

  // On the home page, light up the rail icon of the section being read.
  const icons = Array.from(sb.querySelectorAll<HTMLAnchorElement>('.rail-i a[data-sec]'));
  const secs = icons.map((a) => document.getElementById(a.dataset.sec!)).filter(Boolean) as HTMLElement[];
  if (secs.length) {
    const mark = () => {
      let cur = secs[0].id;
      for (const s of secs) if (s.getBoundingClientRect().top < innerHeight * 0.35) cur = s.id;
      icons.forEach((a) => a.classList.toggle('on', a.dataset.sec === cur));
    };
    addEventListener('scroll', mark, { passive: true });
    mark();
  }
</script>
