---
import Base from '../../../layouts/Base.astro';
import Shell from '../../../components/Shell.astro';
import ProjectPage from '../../../components/ProjectPage.astro';
import { pageProjects } from '../../../lib/data';
import { plain, paths } from '../../../lib/i18n';

export function getStaticPaths() {
  return pageProjects.map(({ project, group }) => ({ params: { slug: project.slug }, props: { project, group } }));
}
const { project, group } = Astro.props;
const img = project.images.find((i) => i.src)?.src;
const alt = paths.project(project.slug, 'en');
---
<Base lang="es" title={`${plain(project.name, 'es')} — Óscar Romero Quincoces`} description={plain(project.say ?? project.short, 'es')} alternate={alt} image={img}>
  <Shell lang="es" current={project.slug} alternate={alt}><ProjectPage lang="es" project={project} group={group} /></Shell>
</Base>
